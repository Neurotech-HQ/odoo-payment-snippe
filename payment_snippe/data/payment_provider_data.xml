<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_snippe" model="payment.provider">
        <field name="name">Snippe</field>
        <field name="code">snippe</field>
        <field name="image_128" type="base64" file="payment_snippe/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_snippe"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment_snippe.payment_method_snippe_mobile_money'),
                         ref('payment.payment_method_card'),
                     ])]"/>
    </record>

</odoo>
