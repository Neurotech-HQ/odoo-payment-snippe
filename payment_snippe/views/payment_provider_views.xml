<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Snippe Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'snippe'" name="snippe_credentials">
                    <field name="snippe_api_key"
                           string="API Key"
                           required="code == 'snippe' and state != 'disabled'"
                           password="True"/>
                    <field name="snippe_webhook_secret"
                           string="Webhook Secret"
                           required="code == 'snippe' and state != 'disabled'"
                           password="True"/>
                    <field name="snippe_api_url"
                           string="API URL"
                           required="code == 'snippe' and state != 'disabled'"
                           groups="base.group_no_one"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
